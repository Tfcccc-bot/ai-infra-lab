# configs/pd-1p1d.env
# 跨机 1P1D Prefill/Decode 分离 —— DeepSeek 系列模型（MoE + MLA）
# 用法：被 launcher/start_*.sh 通过 `source` 读取。
#       改这一份文件即可，脚本里不散落参数。

# ============================================================
# 0. 模型（★★★ 必填，改成 deepseekv4pro 的真实路径 / HF id ★★★）
#    说明："deepseekv4pro" 不是公开 HF 仓库名，请填真实的
#    本地权重目录或 HuggingFace id，例如：
#      MODEL_PATH="/data/models/deepseek-v4-pro"
#      MODEL_PATH="deepseek-ai/DeepSeek-V3-0324"   # 仅作参考示例
# ============================================================
MODEL_PATH="CHANGEME-deepseekv4pro-path-or-hf-id"

# DeepSeek 系列需要 trust-remote-code（自定义 modeling code）
TRUST_REMOTE_CODE="--trust-remote-code"

# ============================================================
# 1. 网络拓扑（★★★ 按实际机器改 ★★★）
# ============================================================
PREFILL_IP="10.0.0.1"          # prefill 节点对外 IP
DECODE_IP="10.0.0.2"           # decode 节点对外 IP
ROUTER_IP="0.0.0.0"            # router 监听地址（对外用 0.0.0.0）

# torch 分布式 init 地址（多机时通常是每侧的 master 节点 IP）
PREFILL_MASTER_IP="${PREFILL_IP}"
DECODE_MASTER_IP="${DECODE_IP}"

# ============================================================
# 2. 端口
# ============================================================
PREFILL_PORT=30000
DECODE_PORT=30001
ROUTER_PORT=8000
DIST_INIT_PORT=5000
BOOTSTRAP_PORT=8998             # decode 经此端口向 prefill 取 bootstrap 信息

# ============================================================
# 3. 并行配置（★★★ 按实际卡数 / 模型规模改 ★★★）
#    DeepSeek-V3-0324 (671B MoE) 参考：2 节点 × 8×H800，TP16 + DP8
#    "deepseekv4pro" 的参数量未公开，务必按显存重算 nnodes/tp/dp。
# ============================================================
NNODES=2
TP_SIZE=16
DP_SIZE=8

# ============================================================
# 4. KV 传输后端
# ============================================================
# mooncake（默认，需 RDMA）/ nixl / mooncake_tcp（无 RDMA 调试用）
TRANSFER_BACKEND="mooncake"
# Mooncake 用的 InfiniBand 设备名（ibv_devinfo 里看到的 HCA），
# 支持：单设备 "mlx5_0" / 逗号列表 "mlx5_0,mlx5_1" / per-GPU JSON。
# 仅 mooncake 后端生效；nixl 会自行探测。
IB_DEVICE="mlx5_0"

# ============================================================
# 5. MoE / MLA / 内存
# ============================================================
# DeepSeek MoE 用 deepep（需装 deep_ep）；非 MoE 模型置空
MOE_A2A_BACKEND="deepep"
ENABLE_DP_ATTENTION="--enable-dp-attention"
MEM_FRACTION_STATIC=0.8
MAX_RUNNING_REQUESTS=128        # decode 侧并发上限

# ============================================================
# 6. 环境变量（Mooncake / 超时）
# ============================================================
# —— MLA 模型（DeepSeek-V2/V3 系列）务必【不要】开 staging buffer ——
#    异构 TP 的 staging 仅适用非 MLA（GQA/MHA），且只对 mooncake 生效。
# export SGLANG_DISAGG_STAGING_BUFFER=0

# NVL72 整机 NVLink 组网时按需打开：
# export SGLANG_MOONCAKE_CUSTOM_MEM_POOL=NVLINK
# export MC_FORCE_MNNVL=True

# 跨机超时（默认 300s；若可接受更高 TTFT 可放宽）
export SGLANG_DISAGGREGATION_BOOTSTRAP_TIMEOUT=300
export SGLANG_DISAGGREGATION_WAITING_TIMEOUT=300
export SGLANG_DISAGGREGATION_HEARTBEAT_INTERVAL=5.0
export SGLANG_DISAGGREGATION_HEARTBEAT_MAX_FAILURE=2
